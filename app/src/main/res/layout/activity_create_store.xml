<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/color_surface"
        app:titleTextColor="@color/color_on_background"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">

            <!-- Banner Picker -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Store Banner" android:textSize="13sp"
                android:textColor="@color/color_on_surface_variant" android:layout_marginBottom="8dp"/>
            <ImageView android:id="@+id/ivBanner" android:layout_width="match_parent"
                android:layout_height="180dp" android:scaleType="centerCrop"
                android:src="@drawable/ic_placeholder" android:background="@drawable/bg_card_dark"
                android:layout_marginBottom="8dp"/>
            <Button android:id="@+id/btnPickBanner" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Pick Banner Image"
                android:backgroundTint="@color/color_surface_variant" android:textColor="@color/color_primary"
                android:layout_marginBottom="24dp"/>

            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="Store Name"
                style="@style/Widget.App.TextInputLayout" android:layout_marginBottom="14dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etStoreName"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/color_on_background"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="Description"
                style="@style/Widget.App.TextInputLayout" android:layout_marginBottom="14dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etStoreDesc"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textMultiLine" android:minLines="3"
                    android:textColor="@color/color_on_background"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="Phone"
                style="@style/Widget.App.TextInputLayout" android:layout_marginBottom="14dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etStorePhone"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="phone" android:textColor="@color/color_on_background"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="Address"
                style="@style/Widget.App.TextInputLayout" android:layout_marginBottom="32dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etStoreAddress"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/color_on_background"/>
            </com.google.android.material.textfield.TextInputLayout>

            <Button android:id="@+id/btnSave" android:layout_width="match_parent"
                android:layout_height="56dp" android:text="Save Store"
                android:background="@drawable/bg_button_primary" android:textColor="@color/white"
                android:textSize="16sp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
