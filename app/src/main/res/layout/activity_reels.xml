<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <Button
        android:id="@+id/btnClose"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:text="✕"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:background="@color/color_overlay"
        android:elevation="8dp"/>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerReels"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <TextView
        android:id="@+id/tvNoReels"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="🎬\n\nNo reels available yet.\nSellers will add video reels to their products."
        android:textSize="15sp"
        android:textColor="@color/color_on_surface_variant"
        android:gravity="center"
        android:visibility="gone"/>
</FrameLayout>
